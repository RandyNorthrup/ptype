{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.{test,spec}.{ts,tsx}",
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "vite.config.ts",
    "vitest.config.ts",
  ],
  "ignore": ["**/*.d.ts", "build/**", "coverage/**", "dist/**"],
  "ignoreDependencies": [
    "prettier",
    "stylelint-config-standard",
    // Knip 6.32 reports this import as unused even though --trace-dependency resolves it.
    "js-yaml",
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "binaries": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "exports": "error",
    "files": "error",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error",
  },
}
