{
  "name": "ptype",
  "version": "2.0.0",
  "description": "P-Type: 3D Typing Game - Defend against enemy spaceships by typing words in this immersive 3D typing game",
  "type": "module",
  "engines": {
    "node": ">=24.4.0",
    "npm": ">=11.4.2"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist coverage .eslintcache .stylelintcache",
    "clean:dist": "rimraf dist",
    "build": "npm run clean:dist && tsc && vite build",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "preview": "vite preview",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "eslint --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings=0",
    "lint:html": "htmlhint index.html",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "deadcode": "knip --strict",
    "cycles": "dpdm --no-warning --no-tree --exit-code circular:1 src/main.tsx",
    "duplicates": "jscpd --config .jscpd.json",
    "quality": "npm run format:check && npm run lint && npm run lint:css && npm run lint:html && npm run typecheck && npm run test && npm run deadcode && npm run cycles && npm run duplicates && npm run security:deps && npm run build",
    "security:deps": "npm audit --audit-level=low"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RandyNorthrup/ptype.git"
  },
  "keywords": [
    "typing",
    "game",
    "3d",
    "threejs",
    "pwa",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RandyNorthrup/ptype/issues"
  },
  "homepage": "https://github.com/RandyNorthrup/ptype#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "cross-env": "10.1.0",
    "dpdm": "4.3.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "htmlhint": "1.9.2",
    "jscpd": "5.0.16",
    "jsdom": "29.1.1",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "js-yaml": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  }
}
