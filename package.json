{
  "name": "ptype",
  "version": "2.0.1",
  "description": "P-Type: 3D Typing Game - Defend against enemy spaceships by typing words in this immersive 3D typing game",
  "type": "module",
  "engines": {
    "node": ">=24.4.0",
    "npm": ">=11.4.2"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist coverage .eslintcache .stylelintcache",
    "clean:dist": "rimraf dist",
    "build": "npm run clean:dist && tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "eslint --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings=0",
    "lint:html": "htmlhint index.html",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "deadcode": "knip && knip --strict",
    "cycles": "dpdm --no-warning --no-tree --exit-code circular:1 src/main.tsx",
    "duplicates": "jscpd --config .jscpd.json",
    "quality": "npm run quality:code && npm run security:secrets",
    "security:deps": "npm audit --audit-level=low",
    "lint:workflows": "actionlint && zizmor --pedantic .github --no-progress",
    "security:code": "node tests/code-scan.ts",
    "security:osv": "osv-scanner scan source -r .",
    "security:secrets": "gitleaks git --redact --no-banner",
    "test:red": "node tests/red-drills.ts",
    "test:browser": "playwright test",
    "test:browser:dev": "npm run build && playwright test --project=development",
    "quality:code": "npm run quality:static && npm run test:red && npm run test:browser",
    "security:files": "gitleaks dir src --redact --no-banner --verbose",
    "quality:static": "npm run ci:parity && npm run format:check && npm run lint && npm run lint:css && npm run lint:html && npm run typecheck && npm run test && npm run deadcode && npm run cycles && npm run duplicates && npm run security:deps && npm run lint:workflows && npm run security:files && npm run security:code && npm run security:osv && npm run build",
    "ci:parity": "node tests/ci-parity.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RandyNorthrup/ptype.git"
  },
  "keywords": [
    "typing",
    "game",
    "3d",
    "threejs",
    "pwa",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RandyNorthrup/ptype/issues"
  },
  "homepage": "https://github.com/RandyNorthrup/ptype#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-three/test-renderer": "9.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "dpdm": "4.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.12.0",
    "htmlhint": "1.9.2",
    "jscpd": "5.3.2",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "js-yaml": "5.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  }
}
